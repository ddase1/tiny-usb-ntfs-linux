CONFIG_EMBEDDED=y
CONFIG_X86_64=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n
CONFIG_STOP_MACHINE=y

# TCP/IP 网络栈
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV4=y
CONFIG_NETDEVICES=y

# USB 全部模块化
CONFIG_USB_SUPPORT=y
CONFIG_USB=m
CONFIG_USB_COMMON=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=m
CONFIG_USB_ANNOUNCE_NEW_DEVICES=n

# NTFS 文件系统【模块，只读】
CONFIG_NTFS_FS=m
# CONFIG_NTFS_DEBUG=n

# 基础文件系统，rootfs依赖
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_RAMFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BLOCK=y

# 关闭多余子系统
CONFIG_SOUND=n
CONFIG_INPUT=n
CONFIG_VT=n
CONFIG_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_KALLSYMS=n
CONFIG_TRACEPOINTS=n
CONFIG_BUG=n
CONFIG_CRYPTO_USER=n
CONFIG_DMADEVICES=n
CONFIG_HWMON=n
CONFIG_POWER_SUPPLY=n
CONFIG_RTC_CLASS=n

# 内核镜像压缩 XZ
CONFIG_KERNEL_XZ=y
